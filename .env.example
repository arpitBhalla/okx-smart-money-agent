# Datadash API key (Settings > API Keys on datadash.xyz). Sent as X-Api-Key to the MCP server.
DATADASH_API_KEY=

# The ASP Agent ID returned by `onchainos agent create`. Required for `round` and `run`.
OKX_ASP_AGENT_ID=

# Optional overrides (defaults shown)
# DATADASH_MCP_URL=https://api.datadash.xyz/mcp
# STATE_FILE=./data/state.json
# SCAN_INTERVAL_MIN=10
# MAX_SIGNALS_PER_ROUND=3
# SIGNAL_VALID_HOURS=2
# DRY_RUN=0

# Signal thresholds (defaults shown)
# MAX_TRADER_RANK=500
# MIN_SCORE=80
# MIN_REL_SIZE=3
# MIN_TRADE_USD=5000
# MIN_PRICE=0.10
# MAX_PRICE=0.90
# MAX_CHASE=0.03
# MAX_DAYS_LEFT=120
