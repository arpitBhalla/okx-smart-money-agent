# Datadash API key (Settings > API Keys on datadash.xyz). Sent as X-Api-Key to the MCP server.
DATADASH_API_KEY=

# The ASP Agent ID returned by `onchainos agent create`. Required for `round` and `run`.
OKX_ASP_AGENT_ID=

# Optional overrides (defaults shown)
# DATADASH_MCP_URL=https://api.datadash.xyz/mcp
# STATE_FILE=./data/state.json
# SCAN_INTERVAL_MIN=2
# MAX_SIGNALS_PER_ROUND=3
# MAX_SIGNALS_PER_EVENT=1
# MAX_SIGNALS_PER_TRADER=1
# SIGNAL_VALID_HOURS=2
# DRY_RUN=0

# Health and alerts (data/health.json is rewritten after every round)
# HEALTH_FILE=./data/health.json
# ALERT_WEBHOOK_URL=            # Slack or Discord incoming webhook; empty = alerts only in the log
# ALERT_AFTER_FAILURES=3
# PENDING_ALERT_MIN=15          # alert when a subscription waits this long for the agent session to accept it

# Signal thresholds (defaults shown)
# MAX_TRADER_RANK=500
# MIN_SCORE=80
# MIN_REL_SIZE=3
# MIN_TRADE_USD=5000
# MIN_PRICE=0.10
# MAX_PRICE=0.85
# MAX_CHASE=0.03
# MAX_DROP=0.10
# MAX_DAYS_LEFT=120
# MAX_POSITION_AGE_DAYS=7
# MIN_CONSENSUS_SHARE=0.6      # share of top-500 money on the market that must be on the signal's side
# MIN_CONSENSUS_WALLETS=3
